# Frontend (bundled into the static site; both values are public by design).
# Use your DEV Supabase project here. Production values are set only in Render.
VITE_SUPABASE_URL=https://your-dev-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-dev-anon-key

# ---- Tests only. Never set these in Render or anywhere the app is built. ----
# Plain Postgres >= 15 superuser URL for `npm run test:db` (migrations + RLS, no Docker).
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Live Supabase stack (local `supabase start` or the DEV project) for `npm run test:rls`
# and `npm run test:e2e`. These tests create and delete users; never use production.
SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
