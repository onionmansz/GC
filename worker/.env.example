# Your PRODUCTION Supabase project (Project Settings → API).
SUPABASE_URL=https://your-project-ref.supabase.co
# The public anon key (the same one the app uses). NOT the service_role key.
SUPABASE_ANON_KEY=

# The Auto-check account you created (see README → "Automatic balance checks").
WORKER_EMAIL=autocheck@example.com
WORKER_PASSWORD=

# Optional tuning
POLL_INTERVAL_SECONDS=5
CHECK_TIMEOUT_SECONDS=120

# Assisted checks (Sport Chek): the address your phone uses to reach this server's
# live view, port 8787. At home, the server's LAN address, e.g. http://192.168.1.20:8787
# With Tailscale (works anywhere): http://<server's tailscale name or 100.x address>:8787
# Leave empty to turn assisted checks off.
VIEWER_PUBLIC_URL=
# How long an assisted check waits for you to finish the robot check.
ASSIST_TIMEOUT_SECONDS=300
